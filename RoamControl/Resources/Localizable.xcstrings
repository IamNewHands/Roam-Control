            "state": "translated",
            "value": "数据收集说明"
          }
        }
      }
    },
    "When using mobile data, temporarily turn it off when asked. Roam Control continues automatically once the local connection is available, and tells you when data can go back on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When using mobile data, temporarily turn it off when asked. Roam Control continues automatically once the local connection is available, and tells you when data can go back on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在使用移动蜂窝网络时，请在提示时短暂关闭蜂窝数据。本地连接就绪后 Roam Control 会自动继续，并在可以重新开启蜂窝数据时通知您。"
          }
        }
      }
    },
    "You are using a newer local test build (%@ Build %@).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are using a newer local test build (%@ Build %@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您正在使用更新的本地测试构建版本（%@ Build %@）。"
          }
        }
      }
    },
    "You have the latest public release (%@).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have the latest public release (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您当前使用的是最新的公开发布版本（%@）。"
          }
        }
      }
    },
    "Your location will move along this route at the selected pace.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location will move along this route at the selected pace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的定位将按照所选步速沿此路线移动。"
          }
        }
      }
    },
    "Your pairing record and local choices will be removed. You will return to the welcome screen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的配对记录与本地设置将被清除，并返回欢迎引导界面。"
          }
        }
      }
    },
    "Your real location is not available yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your real location is not available yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无法获取您的真实位置。"
          }
        }
      }
    },
    "Your spoofed location is being held here until you resume.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟位置将驻留在当前点，直到您点击继续。"
          }
        }
      }
    },
    "iOS background processing is unavailable. Check Background App Refresh for Roam Control in Settings, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS background processing is unavailable. Check Background App Refresh for Roam Control in Settings, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 后台处理不可用。请在“设置”中检查 Roam Control 的“后台 App 刷新”权限后重试。"
          }
        }
      }
    },
    "iOS could not keep pairing active in the background. Keep Roam Control open and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS could not keep pairing active in the background. Keep Roam Control open and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 无法在后台保持配对活跃。请保持 Roam Control 在前台运行并重试。"
          }
        }
      }
    },
    "iOS could not prepare the location session. Close Roam Control, reopen it, and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS could not prepare the location session. Close Roam Control, reopen it, and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 无法准备定位会话。请关闭 Roam Control 重新打开后重试。"
          }
        }
      }
    },
    "iOS could not register the secure pairing task. Close Roam Control, reopen it, and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS could not register the secure pairing task. Close Roam Control, reopen it, and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 无法注册安全配对任务。请关闭 Roam Control 重新打开后重试。"
          }
        }
      }
    },
    "iOS could not schedule pairing. Try again, and copy Diagnostics from Connection Health if it continues.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS could not schedule pairing. Try again, and copy Diagnostics from Connection Health if it continues."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 无法安排配对调度。请重试；若问题持续，请在“连接健康状况”中复制诊断信息。"
          }
        }
      }
    },
    "iOS could not start pairing immediately under current system conditions. Keep Roam Control open and try again shortly.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS could not start pairing immediately under current system conditions. Keep Roam Control open and try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在当前系统状态下 iOS 无法立即启动配对。请保持 Roam Control 打开并稍后重试。"
          }
        }
      }
    },
    "iOS did not permit the pairing background task. Copy Diagnostics from Connection Health so this installation can be checked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS did not permit the pairing background task. Copy Diagnostics from Connection Health so this installation can be checked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
