    "An inactive session means Roam Control's worker has ended. Other apps may need time to acquire a fresh real location.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An inactive session means Roam Control's worker has ended. Other apps may need time to acquire a fresh real location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未激活会话表示 Roam Control 的工作进程已结束。其他 App 可能需要一些时间来获取最新的真实定位。"
          }
        }
      }
    },
    "Anonymous Statistics": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名使用统计"
          }
        }
      }
    },
    "Another VPN may affect local device connections. If it is appropriate for your network, compare a test with that VPN paused. Keep LocalDevVPN enabled when starting a location session.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another VPN may affect local device connections. If it is appropriate for your network, compare a test with that VPN paused. Keep LocalDevVPN enabled when starting a location session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他 VPN 可能会影响本地设备连接。在网络条件允许的情况下，可尝试暂停其他 VPN 进行对比测试。启动定位会话时请务必保持 LocalDevVPN 开启。"
          }
        }
      }
    },
