    "Copies a status-only report you can paste into a bug report. It never includes locations, searches, pairing records, PINs, device names or error text.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies a status-only report you can paste into a bug report. It never includes locations, searches, pairing records, PINs, device names or error text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制仅包含状态的诊断报告，以便粘贴到问题反馈中。报告绝不包含定位信息、搜索记录、配对文件、PIN 码、设备名称或具体报错详情。"
          }
        }
      }
    },
